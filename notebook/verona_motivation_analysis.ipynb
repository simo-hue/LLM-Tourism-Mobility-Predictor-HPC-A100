    "        return {\n",
    "            'cached_files': len(self.cache_index),\n",
    "            'cache_dir_size': sum(f.stat().st_size for f in self.cache_dir.glob('*.pkl')),\n",
    "            'cache_dir': str(self.cache_dir)\n",
    "        }\n",
